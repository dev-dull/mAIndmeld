# mAIndmeld runner image: the runner from this repo plus agent harnesses
# preinstalled, so a laptop or a cluster can launch a harness into a room
# without the server ever running a command. Unprivileged; no Docker
# socket; harness credentials come from mounted config and the environment.
#
# Harnesses here: Claude Code and OpenCode (both install from npm). Add
# others with a derived image: FROM this, RUN npm install -g <package>.

FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git ripgrep \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code opencode-ai \
 && npm cache clean --force

WORKDIR /app
COPY package.json ./
COPY bin ./bin
COPY src ./src
COPY templates ./templates

ENV NODE_ENV=production \
    HOME=/home/node \
    MAINDMELD_RUNNER_CONFIG=/config/runner.json

RUN mkdir -p /state /config /home/node && chown -R node:node /state /config /home/node /app
USER node
VOLUME ["/state", "/home/node"]

# The runner keeps its prompt files and capped logs under /state; harness
# auth and caches live under /home/node (mount it to keep logins).
CMD ["sh", "-c", "exec node bin/maindmeld.js runner --config \"$MAINDMELD_RUNNER_CONFIG\""]
